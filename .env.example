# All variables are optional; the defaults shown are what applies when a line is missing.

# Host interface the beacon is published on. Use the LAN IP of this host so the
# endpoint is reachable only on the network it identifies (never through the tunnel).
BEACON_BIND=0.0.0.0

# Host port. Together with BEACON_BIND this is the "host:port" entered in Zero Trust.
BEACON_PORT=3333

# Common name and SAN of the self-signed certificate (generated on first start).
BEACON_CN=warp-beacon.internal

# Certificate validity in days. Only used when the certificate is generated.
CERT_DAYS=3650
